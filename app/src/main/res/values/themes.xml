<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.IPCamViewer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cam_primary</item>
        <item name="colorSecondary">@color/cam_accent</item>
        <item name="android:colorBackground">@color/cam_background</item>
        <item name="colorSurface">@color/cam_surface</item>
        <item name="android:statusBarColor">@color/cam_background</item>
